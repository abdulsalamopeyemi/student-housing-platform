# Supabase public project configuration.
# These values are safe for browser/server use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://vucekwajkvrlcxzpqolc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wRnzMotB-oPSu7P-Fm5iJQ_EX4G3L_g

# Never add a Supabase secret key or service-role key to NEXT_PUBLIC_ variables
# or commit those secrets to source control.


# Optional locally. In production set this to the public deployed app URL,
# for example https://your-app.example.com. Supabase must also allow this URL.
NEXT_PUBLIC_SITE_URL=

# Server-only keys used by the accommodation payment flow.
# Never expose these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# In Paystack, configure the webhook URL in production as:
# https://your-public-domain.com/api/payments/paystack/webhook
